<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sockets for every probe, discovery and lookup NetScope performs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ConnectivityManager, LinkProperties, NetworkCapabilities. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WifiManager state, connection info and cached scan results. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Only used to ask the platform for a fresh Wi-Fi scan. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Wi-Fi scan results on API 33+. neverForLocation is declared because NetScope does
      not derive the device's position from access points: it shows them as network
      infrastructure.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!--
      WifiManager.startScan/getScanResults remain location-sensitive APIs on current
      Android releases. NetScope requests this only for the user-visible Wi-Fi analyzer
      and never derives or stores physical position from scan results.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Local network access. Newer releases require an explicit grant before an app may
      reach other devices on the LAN, which covers TCP and ICMP probing as well as mDNS
      and SSDP discovery.

      It is declared by name rather than through a constant because this build compiles
      against an older SDK. Declaring a permission the running platform does not define
      is inert, and the permission is only enforced for apps targeting the level that
      introduced it, so this is safe on every release NetScope supports. The app asks the
      platform at runtime which name it actually defines - see PermissionPolicy.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Optional: new-device alerts and the host monitor. Off by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The Wi-Fi feature is used when present but the app is useful on Ethernet too. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".NetScopeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetScope"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.NetScope">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Serves exported scan files through a content URI so sharing needs no storage
          permission and nothing is written to shared storage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
